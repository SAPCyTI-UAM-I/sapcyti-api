# Railway API service variables.
# Copy these into Railway > api service > Variables.
# Do not commit real secrets or real JWT keys.

SPRING_PROFILES_ACTIVE="docker,prod"
SERVER_PORT="8080"
PORT="8080"
SERVER_ADDRESS="::"

DB_URL="jdbc:postgresql://${{postgres.PGHOST}}:${{postgres.PGPORT}}/${{postgres.PGDATABASE}}"
DB_USER="${{postgres.PGUSER}}"
DB_PASS="${{postgres.PGPASSWORD}}"

CORS_ALLOWED_ORIGINS="https://spa-production-7348.up.railway.app"

# Required with SPRING_PROFILES_ACTIVE including prod (SPEC-038): inline PEM only — no classpath fallback.
# Generate fresh keys and paste the full multiline values in Railway UI.
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
PEGA_AQUI_TU_LLAVE_PRIVADA_RSA
-----END PRIVATE KEY-----"

JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
PEGA_AQUI_TU_LLAVE_PUBLICA_RSA
-----END PUBLIC KEY-----"

# Password recovery email via Resend (prod sets app.email.provider=resend)
RESEND_API_KEY="re_xxxxxxxx"
RESEND_FROM="SAPCyTI <noreply@tu-dominio.com>"
PASSWORD_RESET_BASE_URL="https://spa-production-7348.up.railway.app"
PASSWORD_RESET_TTL_MINUTES="30"
