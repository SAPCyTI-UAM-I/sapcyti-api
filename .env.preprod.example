# On-premise preprod template — pair with Compose project name sapcyti-preprod (Architecture §7)
# Copy to server-side .env — never commit real secrets
COMPOSE_PROJECT_NAME=sapcyti-preprod

DB_URL=jdbc:postgresql://db:5432/CHANGE_ME
DB_USER=CHANGE_ME
DB_PASS=CHANGE_ME

POSTGRES_DB=CHANGE_ME
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME

SPRING_PROFILES_ACTIVE=preprod
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=https://CHANGE_ME.example
