# ==============================================================================
# Variables para el Script de Bienvenida (send_welcome_emails.py)
# Copia este archivo como .env en esta misma carpeta:
#   cp .env.example .env
# ==============================================================================

# 1. API Key de Resend (https://resend.com/api-keys)
RESEND_API_KEY=re_tu_api_key_aqui

# 2. Remitente y correo de contacto (dominio verificado sapcyti.site)
RESEND_FROM="SAPCyTI <soporte@sapcyti.site>"

# 3. Correo para recibir respuestas de los alumnos:
RESEND_REPLY_TO=soporte@sapcyti.site

# 4. Enlaces de la plataforma y de la encuesta
APP_URL=https://sapcyti.site
FEEDBACK_URL=https://forms.gle/tuFormularioDeFeedback
SUPPORT_EMAIL=soporte@sapcyti.site
