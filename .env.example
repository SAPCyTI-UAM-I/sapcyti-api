# Copy to .env and export (Linux/macOS) or set for the shell session (Windows).
# Align values with docker-compose.dev.yml from Phase 0.

DB_URL=jdbc:postgresql://localhost:5433/sapcyti_dev
DB_USER=sapcyti
DB_PASS=sapcyti_dev_pass

SPRING_PROFILES_ACTIVE=dev

# Comma-separated origins for WebConfig / CORS
CORS_ALLOWED_ORIGINS=http://localhost:4200

SERVER_PORT=8080

# Password recovery (HU-02) — MailHog from sapcyti-infra/local-dev/docker-compose.db.yml
# SMTP UI: http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
PASSWORD_RESET_BASE_URL=http://localhost:4200

# JWT RSA keys (optional in dev — defaults to classpath:jwt/dev-*.pem)
# JWT_PRIVATE_KEY_PATH=file:/path/to/private.pem
# JWT_PUBLIC_KEY_PATH=file:/path/to/public.pem
