# ==============================================================================
# SAPCyTI API — Variables de Entorno (.env)
# Copia este archivo como .env en la raíz de sapcyti-api o úsalo como referencia.
# ==============================================================================

# Base de datos PostgreSQL
DB_URL=jdbc:postgresql://localhost:5433/sapcyti_dev
DB_USER=sapcyti
DB_PASS=sapcyti_dev_pass

# Perfil activo de Spring (dev / docker / prod)
SPRING_PROFILES_ACTIVE=dev

# Orígenes CORS permitidos (separados por coma)
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Puerto del servidor backend
SERVER_PORT=8080

# ==============================================================================
# Entorno de Desarrollo Local (MailHog vía SMTP)
# Solo aplica cuando APP_EMAIL_PROVIDER=smtp (o perfiles dev / docker)
# ==============================================================================
SMTP_HOST=localhost
SMTP_PORT=1025
PASSWORD_RESET_BASE_URL=http://localhost:4200

# ==============================================================================
# Entorno de Producción / Integración con Resend (SPEC-038)
# Requiere que el dominio sapcyti.site esté en estado 'Verified' en Resend.
# ==============================================================================

# Proveedor de correo: 'resend' para producción, 'smtp' para desarrollo local
APP_EMAIL_PROVIDER=resend

# API Key generada en https://resend.com/api-keys (comienza con re_...)
RESEND_API_KEY=re_tu_api_key_aqui

# Remitente con tu dominio verificado (sapcyti.site):
RESEND_FROM="SAPCyTI <soporte@sapcyti.site>"

# Correo de contacto/respuestas:
RESEND_REPLY_TO=soporte@sapcyti.site

# URL base de la aplicación web en producción (usada para los enlaces de recuperación)
PASSWORD_RESET_BASE_URL=https://sapcyti.site
PASSWORD_RESET_TTL_MINUTES=30

# Claves JWT RSA para producción (SPEC-038 / D-017)
# En prod son obligatorias en formato PEM en línea:
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
